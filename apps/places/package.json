{
  "name": "@mapable/static-companion",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npm run generate:directory && expo start",
    "android": "npm run generate:directory && expo start --android",
    "ios": "npm run generate:directory && expo start --ios",
    "web": "npm run generate:directory && expo start --web",
    "build:web": "npm run generate:directory && expo export --platform web --output-dir dist",
    "typecheck": "npm run generate:directory && tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:prototype": "npm run test && npm run typecheck && npm run build:web",
    "generate:directory": "node scripts/generate-provider-directory.mjs"
  },
  "dependencies": {
    "expo": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "@expo/metro-runtime": "~57.0.10",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
