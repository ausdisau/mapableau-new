# Public origin of the supplied Clerk instance. For a development tenant,
# replace this with its own Frontend API origin and use its matching keys.
CLERK_FRONTEND_API_URL=https://clerk.accessibooks.com.au
# Copy the publishable key into the Next.js variable even if exported by a Vite app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Set server-side in the deployment's secret store or a local .env.local.
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional Neon public.services directory (read-only). Leave false.
# Never point at production neon_auth or member databases.
DATABASE_URL=
ADID_DIRECTORY_ENABLED=false
ADID_NEON_DIRECTORY_ENABLED=false

# Optional separate database for access requests, provisioned with integrations/neon/access-requests.sql.
ADID_ACCESS_REQUESTS_DATABASE_URL=
# Server-only JSON mapping of Clerk subjects to the service IDs each person may review.
ADID_ACCESS_REVIEWERS={}

# Wix Stage 1: verified public AD.iD sign-in link builders (still needs host allowlist).
ADID_WIX_PUBLIC_LINK_ENABLED=false

# Stages 2–3 and federation — must remain false until separately reviewed.
ADID_ACCOUNT_LINKING_ENABLED=false
ADID_WIX_SESSION_BRIDGE_ENABLED=false
ADID_CROSS_APP_FEDERATION_ENABLED=false

# Optional: comma-separated approved AD.iD hostnames for Stage 1 (no scheme).
# ADID_APPROVED_HOSTS=adid.example.com

# Public Clerk routing (SDK v7). Secrets always belong in deployment configuration.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
