# Development or protected preview only. Never commit credentials.
# Operator: create/select a separate Clerk *development* instance and copy
# keys into .env.local (outside chat). Do not create production keys here.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Firebase client (optional analytics). Clerk remains AD.iD auth.
# Full template: packages/firebase/.env.example
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional Neon public.services directory (read-only). Leave false.
# Never point at production neon_auth or member databases.
DATABASE_URL=
ADID_DIRECTORY_ENABLED=false
ADID_NEON_DIRECTORY_ENABLED=false

# Wix Stage 1: verified public AD.iD sign-in link builders (still needs host allowlist).
ADID_WIX_PUBLIC_LINK_ENABLED=false

# Stages 2–3 and federation — must remain false until separately reviewed.
ADID_ACCOUNT_LINKING_ENABLED=false
ADID_WIX_SESSION_BRIDGE_ENABLED=false
ADID_CROSS_APP_FEDERATION_ENABLED=false

# Optional: comma-separated approved AD.iD hostnames for Stage 1 (no scheme).
# ADID_APPROVED_HOSTS=adid.example.com
