# Server API origin for MapAble mobile. Keep explicit per environment so a
# development build never silently talks to production.
# Production example (only after deployment/domain verification):
# EXPO_PUBLIC_MAPABLE_API_URL=https://mapable.com.au
EXPO_PUBLIC_MAPABLE_API_URL=

# Public MapAble web origin used for secure-web fallbacks while protected native
# session exchange is still gated. Defaults to https://mapable.com.au.
EXPO_PUBLIC_MAPABLE_WEB_URL=https://mapable.com.au

# Media SoR — AccessiBooks deep link (ausdisau/access-media apps/accessibooks)
# Example: https://accessibooks.example.org
EXPO_PUBLIC_ACCESSIBOOKS_URL=

# Optional: DisabilityFour+ deep link
# EXPO_PUBLIC_DISABILITYFOUR_URL=
