{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapAble semantic token source",
  "type": "object",
  "required": ["name", "version", "themes", "type", "spaceRem", "radius", "motion", "accessibility", "contrastPairs"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "themes": {
      "type": "object",
      "required": ["light", "dark", "contrast"],
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/theme" },
        "dark": { "$ref": "#/$defs/theme" },
        "contrast": { "$ref": "#/$defs/theme" }
      }
    },
    "type": {
      "type": "object",
      "required": ["body", "display", "mono", "readable", "scaleRem"],
      "properties": {
        "body": { "type": "string" }, "display": { "type": "string" },
        "mono": { "type": "string" }, "readable": { "type": "string" },
        "scaleRem": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } }
      },
      "additionalProperties": false
    },
    "spaceRem": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
    "radius": { "type": "object", "required": ["control", "panel"], "additionalProperties": { "type": "string" } },
    "motion": {
      "type": "object",
      "required": ["durationMs", "easing", "properties"],
      "properties": {
        "durationMs": { "type": "number", "minimum": 0 },
        "easing": { "type": "string" },
        "properties": { "type": "array", "items": { "enum": ["transform", "opacity"] } }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["targetPx", "focusPx", "focusOffsetPx", "normalTextContrast", "uiContrast"],
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "contrastPairs": {
      "type": "array",
      "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "theme": {
      "type": "object",
      "required": ["background", "surface", "text", "muted", "primary", "primary-hover", "on-primary", "violet", "violet-tint", "tint", "gold", "orange", "gold-tint", "warning", "danger", "danger-hover", "on-danger", "danger-tint", "border", "rule", "focus", "disabled-surface", "disabled-text"],
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    }
  }
}
