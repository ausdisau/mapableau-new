{
  "$schema": "./tokens.schema.json",
  "name": "MapAble / Guided independence",
  "version": "1.0.0",
  "description": "Semantic sRGB hex colors. CSS generator emits space-separated HSL channels. Brand derivatives are not claims of exact artwork sampling.",
  "themes": {
    "light": {
      "background": "#f4f5fa", "surface": "#fffcf7", "text": "#20354b", "muted": "#536174",
      "primary": "#185887", "primary-hover": "#12466d", "on-primary": "#fffcf7",
      "violet": "#694781", "violet-tint": "#efe9f5", "tint": "#e6eef7",
      "gold": "#edb52c", "orange": "#c66020", "gold-tint": "#fff0cf", "warning": "#77460d",
      "danger": "#a52c3c", "danger-hover": "#842130", "on-danger": "#fffcf7", "danger-tint": "#fbe9eb",
      "border": "#758398", "rule": "#d9dfe7", "focus": "#694781",
      "disabled-surface": "#e6e8ee", "disabled-text": "#576173"
    },
    "dark": {
      "background": "#172538", "surface": "#203147", "text": "#f4f2ed", "muted": "#b7c4d5",
      "primary": "#a3cff4", "primary-hover": "#c3e2fb", "on-primary": "#172538",
      "violet": "#d5b6ed", "violet-tint": "#392e4b", "tint": "#293e56",
      "gold": "#edbb45", "orange": "#f6ad76", "gold-tint": "#423824", "warning": "#f7cf7c",
      "danger": "#ffb2bd", "danger-hover": "#ffd1d7", "on-danger": "#421c27", "danger-tint": "#442b38",
      "border": "#8799b0", "rule": "#4c6078", "focus": "#edbb45",
      "disabled-surface": "#304157", "disabled-text": "#bcc8d8"
    },
    "contrast": {
      "background": "#f9f6e9", "surface": "#fffdf4", "text": "#142136", "muted": "#354153",
      "primary": "#123f68", "primary-hover": "#0c2e4e", "on-primary": "#fffdf4",
      "violet": "#4c286c", "violet-tint": "#eee4f4", "tint": "#e3edf8",
      "gold": "#d69b15", "orange": "#93410f", "gold-tint": "#ffedb6", "warning": "#5d3506",
      "danger": "#831729", "danger-hover": "#60101f", "on-danger": "#fffdf4", "danger-tint": "#fbe4e8",
      "border": "#354153", "rule": "#354153", "focus": "#123f68",
      "disabled-surface": "#e3e1d6", "disabled-text": "#354153"
    }
  },
  "type": {
    "body": "\"Avenir Next\", \"Trebuchet MS\", sans-serif",
    "display": "Georgia, \"Times New Roman\", serif",
    "mono": "ui-monospace, \"Cascadia Code\", monospace",
    "readable": "\"Atkinson Hyperlegible\", Verdana, sans-serif",
    "scaleRem": [0.75, 0.875, 1, 1.125, 1.65, 2, 3.2, 5.3]
  },
  "spaceRem": [0.25, 0.5, 0.75, 1, 1.5, 2, 3, 4, 6],
  "radius": { "control": "0.65rem", "panel": "1.5rem" },
  "motion": { "durationMs": 160, "easing": "ease", "properties": ["transform", "opacity"] },
  "accessibility": { "targetPx": 48, "focusPx": 3, "focusOffsetPx": 4, "normalTextContrast": 4.5, "uiContrast": 3 },
  "contrastPairs": [
    ["text", "background"], ["text", "surface"], ["muted", "background"], ["muted", "surface"],
    ["primary", "surface"], ["primary", "tint"], ["on-primary", "primary"], ["on-primary", "primary-hover"],
    ["violet", "violet-tint"], ["warning", "gold-tint"], ["danger", "danger-tint"], ["danger", "surface"],
    ["on-danger", "danger"], ["on-danger", "danger-hover"], ["disabled-text", "disabled-surface"]
  ]
}
