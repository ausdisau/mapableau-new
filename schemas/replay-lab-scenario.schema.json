{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapable.com.au/schemas/replay-lab-scenario.schema.json",
  "title": "MapAble Replay Lab Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "participant", "goal", "requirements", "timeline", "expected"],
  "properties": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "purpose",
        "mode",
        "author",
        "reviewers",
        "lastReview",
        "deprecation",
        "ontologyVersion",
        "canonicalDomainVersions",
        "policyVersions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": [
            "engineering_regression",
            "provider_exercise",
            "academy_simulation",
            "participant_codesign",
            "partner_conformance",
            "policy_civic"
          ]
        },
        "author": { "type": "string" },
        "reviewers": { "type": "array", "items": { "type": "string" } },
        "lastReview": { "type": ["string", "null"] },
        "deprecation": { "type": "string", "enum": ["active", "deprecated", "retired"] },
        "ontologyVersion": { "type": "string" },
        "canonicalDomainVersions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "policyVersions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "participant": {
      "type": "object",
      "required": ["fixture"],
      "properties": {
        "fixture": { "type": "string" }
      }
    },
    "goal": {
      "type": "object",
      "required": ["type", "outcome"],
      "properties": {
        "type": { "type": "string" },
        "outcome": { "type": "string" }
      }
    },
    "requirements": { "type": "object" },
    "world": { "type": "object" },
    "actors": { "type": "array" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "event"],
        "properties": {
          "at": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
          "event": {
            "type": "string",
            "pattern": "^mapable\\.replay\\."
          },
          "data": { "type": "object" },
          "actor": { "type": "string" }
        }
      }
    },
    "chaos_cards": { "type": "array", "items": { "type": "string" } },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "prohibited": { "type": "array", "items": { "type": "string" } },
    "localisation": { "type": "object" }
  }
}
