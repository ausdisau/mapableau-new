# Copy to apps/mobile/.env for Expo. Values must match packages/firebase/.env.example.

EXPO_PUBLIC_MAPABLE_API_URL=

# Stripe publishable key only (never the secret). Required for PaymentSheet.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Keep true for Google Pay testEnv until a signed production build + Stripe approval.
EXPO_PUBLIC_STRIPE_TEST_MODE=true

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
