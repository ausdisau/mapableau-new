{
  "version": "1.0.0",
  "effectiveDate": "2026-07-16",
  "purposes": [
    {
      "code": "access.verify_venue",
      "description": "Verify accessibility needs for arrival at a venue or interview location",
      "legalBasis": "Participant consent for functional access support",
      "allowedRequesters": ["venue_staff", "provider_manager", "navigator"],
      "allowedRecipients": ["venue", "organisation"],
      "allowedFields": ["arrival_time", "entrance_preference", "written_directions_preference", "assistance_request", "mobility.equipment"],
      "prohibitedFields": ["diagnosis", "access_passport.full", "plan_budget", "medical_history"],
      "allowedOperations": ["read", "disclose"],
      "defaultDurationHours": 4,
      "defaultRetention": "until_visit_complete",
      "onwardSharing": "prohibited",
      "participantReviewRequired": true,
      "humanReviewRequired": false,
      "requiredDuties": ["use_only_for_purpose", "delete_after_use"],
      "affectedProgrammes": ["access"]
    },
    {
      "code": "access.share_visit_plan",
      "description": "Share a time-limited visit plan for a specific outing",
      "legalBasis": "Participant consent",
      "allowedRequesters": ["participant", "navigator", "family_member"],
      "allowedRecipients": ["venue", "supporter", "organisation"],
      "allowedFields": ["visit_plan.summary", "arrival_time", "entrance_preference", "assistance_request"],
      "prohibitedFields": ["diagnosis", "access_passport.full", "home_address.full"],
      "allowedOperations": ["read", "disclose"],
      "defaultDurationHours": 24,
      "defaultRetention": "until_expiry",
      "onwardSharing": "prohibited",
      "participantReviewRequired": true,
      "humanReviewRequired": false,
      "requiredDuties": ["use_only_for_purpose", "no_onward_share"],
      "affectedProgrammes": ["access"]
    },
    {
      "code": "transport.driver_handover",
      "description": "Hand over trip-specific mobility and pickup information to a driver",
      "legalBasis": "Participant consent for safe transport",
      "allowedRequesters": ["transport_operator", "driver", "provider_manager"],
      "allowedRecipients": ["driver", "transport_operator"],
      "allowedFields": ["pickup_point", "pickup_time", "mobility.equipment_dimensions", "boarding_assistance", "companion_count", "destination_entrance"],
      "prohibitedFields": ["diagnosis", "medical_history.full", "access_passport.full", "plan_budget"],
      "allowedOperations": ["read"],
      "defaultDurationHours": 6,
      "defaultRetention": "until_trip_complete",
      "onwardSharing": "prohibited",
      "participantReviewRequired": true,
      "humanReviewRequired": false,
      "requiredDuties": ["use_only_for_purpose", "no_marketing", "delete_after_use"],
      "affectedProgrammes": ["transport"]
    },
    {
      "code": "transport.request_trip",
      "description": "Request and coordinate a transport trip",
      "allowedRequesters": ["participant", "support_coordinator", "navigator"],
      "allowedRecipients": ["transport_operator"],
      "allowedFields": ["pickup_suburb", "dropoff_suburb", "mobility.summary", "requested_time"],
      "prohibitedFields": ["diagnosis", "medical_history.full"],
      "allowedOperations": ["read", "create_derived_data"],
      "defaultDurationHours": 48,
      "participantReviewRequired": false,
      "humanReviewRequired": false,
      "affectedProgrammes": ["transport"]
    },
    {
      "code": "care.worker_handover",
      "description": "Hand over shift-specific support information to a support worker",
      "allowedRequesters": ["provider_manager", "support_worker"],
      "allowedRecipients": ["support_worker", "provider"],
      "allowedFields": ["communication.preferences", "mobility.summary", "routines.summary", "boundaries.summary"],
      "prohibitedFields": ["diagnosis", "plan_budget", "billing.read"],
      "allowedOperations": ["read"],
      "defaultDurationHours": 12,
      "participantReviewRequired": true,
      "affectedProgrammes": ["care"]
    },
    {
      "code": "jobs.interview_access",
      "description": "Provide arrival and access information for a job interview",
      "allowedRequesters": ["employer", "navigator"],
      "allowedRecipients": ["employer"],
      "allowedFields": ["arrival_time", "entrance_preference", "communication.preferences", "assistance_request"],
      "prohibitedFields": ["diagnosis", "access_passport.full"],
      "allowedOperations": ["read", "disclose"],
      "defaultDurationHours": 4,
      "participantReviewRequired": true,
      "affectedProgrammes": ["jobs"]
    },
    {
      "code": "jobs.request_adjustment",
      "description": "Request workplace adjustments based on functional requirements",
      "allowedRequesters": ["participant", "navigator", "employer"],
      "allowedRecipients": ["employer"],
      "allowedFields": ["functional_requirements", "equipment.needs", "communication.preferences"],
      "prohibitedFields": ["diagnosis"],
      "allowedOperations": ["read", "disclose"],
      "defaultDurationHours": 720,
      "participantReviewRequired": true,
      "humanReviewRequired": false,
      "affectedProgrammes": ["jobs"]
    },
    {
      "code": "supporter.notify_change",
      "description": "Notify an authorised supporter of a participant-initiated change",
      "allowedRequesters": ["participant"],
      "allowedRecipients": ["family_member", "nominee"],
      "allowedFields": ["notification.summary"],
      "prohibitedFields": ["billing.read", "plan_budget", "medical_history"],
      "allowedOperations": ["contact"],
      "defaultDurationHours": 168,
      "participantReviewRequired": true,
      "affectedProgrammes": ["core"]
    },
    {
      "code": "complaint.prepare_submission",
      "description": "Prepare a complaint submission with selected evidence",
      "allowedRequesters": ["participant", "navigator"],
      "allowedRecipients": ["rights_officer"],
      "allowedFields": ["complaint.summary", "incident.references"],
      "prohibitedFields": ["unrelated_third_party"],
      "allowedOperations": ["read", "create_derived_data"],
      "participantReviewRequired": true,
      "humanReviewRequired": true,
      "affectedProgrammes": ["cases"]
    },
    {
      "code": "research.approved_study",
      "description": "Participate in an ethics-approved research study with explicit opt-in",
      "allowedRequesters": ["research_node"],
      "allowedRecipients": ["research_institution"],
      "allowedFields": [],
      "prohibitedFields": ["ndis_number", "full_profile"],
      "allowedOperations": ["read"],
      "participantReviewRequired": true,
      "humanReviewRequired": true,
      "affectedProgrammes": ["research"]
    },
    {
      "code": "analytics.service_quality_aggregate",
      "description": "Aggregate de-identified service quality metrics",
      "allowedRequesters": ["system"],
      "allowedRecipients": ["mapable_admin"],
      "allowedFields": ["aggregate.metrics"],
      "prohibitedFields": ["participant.identifiable"],
      "allowedOperations": ["read", "create_derived_data"],
      "participantReviewRequired": false,
      "affectedProgrammes": ["analytics"]
    }
  ],
  "prohibitedVaguePurposes": [
    "improve_services",
    "general_business_use",
    "future_opportunities",
    "personalisation",
    "analytics",
    "administration",
    "research"
  ]
}
